# Salin ke .env.local (tidak di-commit) lalu isi nilainya.
# Nilai asli production/preview disimpan di Vercel Environment Variables, bukan di repo.

# --- Milestone 1 ---
# Neon: pakai connection string "pooled" untuk aplikasi
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon: connection string "direct" (tanpa -pooler) untuk migrasi. Boleh dikosongkan saat lokal,
# dan tidak perlu bila memakai integrasi Neon di Vercel (DATABASE_URL_UNPOOLED terisi otomatis).
DIRECT_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Data pribadi untuk seed profil (tidak ditulis di kode). Boleh dikosongkan.
SEED_PROFILE_EMAIL=""
SEED_PROFILE_WHATSAPP=""

# --- Milestone 2: panel admin ---
# Buat dengan: openssl rand -base64 32 (minimal 32 karakter). Berbeda untuk production dan preview.
BETTER_AUTH_SECRET=""
# URL situs untuk auth. Kosongkan di preview Vercel (otomatis memakai URL deployment).
BETTER_AUTH_URL="http://localhost:3000"
# Akun admin dibuat dari dua kunci ini oleh seed (lokal) atau deploy production pertama di Vercel.
# Password minimal 12 karakter. Setelah admin bisa masuk, hapus ADMIN_PASSWORD dari Vercel.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Opsional: nama tampilan admin (bawaan: nama di profil)
ADMIN_NAME=""
# Hanya untuk: ADMIN_NEW_PASSWORD=... pnpm admin:reset-password
ADMIN_NEW_PASSWORD=""
# Opsional: kunci hash IP untuk rate limit. Bila kosong diturunkan dari BETTER_AUTH_SECRET.
HASH_SALT_SECRET=""
# Unggah foto, CV, dan gambar project. Tanpa ini, bagian unggah di admin nonaktif.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Opsional: menaikkan batas impor repo dari GitHub (token fine-grained tanpa izin tambahan)
GITHUB_TOKEN=""

# --- Milestone 3: email, cron ---
# Resend (resend.com). EMAIL_FROM harus memakai domain yang sudah diverifikasi di Resend.
# Tanpa dua kunci ini: pesan kontak tetap tersimpan di admin, newsletter menampilkan "belum aktif".
RESEND_API_KEY=""
EMAIL_FROM=""
# Kotak masuk pemilik untuk notifikasi pesan kontak baru
CONTACT_TO_EMAIL=""
# Rahasia Vercel Cron untuk /api/cron/daily (minimal 16 karakter acak)
CRON_SECRET=""

# DSN project Sentry untuk laporan error server (opsional, src/instrumentation.ts)
SENTRY_DSN=""
