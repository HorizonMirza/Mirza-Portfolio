# Salin ke .env.local (tidak di-commit) lalu isi nilainya.
# Nilai asli production/preview disimpan di Vercel Environment Variables, bukan di repo.

# --- Milestone 1 ---
# Neon: pakai connection string "pooled" untuk aplikasi
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Neon: connection string "direct" (tanpa -pooler) untuk migrasi. Boleh dikosongkan saat lokal.
DIRECT_URL=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Data pribadi untuk seed profil (tidak ditulis di kode). Boleh dikosongkan.
SEED_PROFILE_EMAIL=""
SEED_PROFILE_WHATSAPP=""

