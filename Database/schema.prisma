// Skema database portofolio. Acuan: Documentation/ARCHITECTURE.md bagian 5.
// Prisma CLI dijalankan dari folder Frontend/ (lihat Frontend/prisma.config.ts).
// Konten publik dua bahasa memakai pasangan kolom `*_id` (Indonesia) dan `*_en` (Inggris).
// Primary key memakai UUID v7 (urut waktu). Semua waktu disimpan sebagai timestamptz (UTC),
// ditampilkan dalam zona Asia/Jakarta. Tanggal kalender (startDate/endDate) memakai @db.Date.

generator client {
  provider = "prisma-client"
  output   = "../Frontend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SUPER_ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ProjectCategory {
  SOFTWARE
  COMMUNITY_BUSINESS
}

enum ExperienceType {
  WORK
  EDUCATION
  ORGANIZATION
}

// Jenis pekerjaan seperti di LinkedIn, tampil di baris instansi ("PT PGAS Solution · Internship")
enum EmploymentType {
  FULL_TIME
  PART_TIME
  SELF_EMPLOYED
  FREELANCE
  CONTRACT
  INTERNSHIP
  APPRENTICESHIP
  SEASONAL
  VOLUNTEER
}

enum AssetKind {
  IMAGE
  DOCUMENT
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

// Tabel autentikasi mengikuti skema Better Auth (lihat Frontend/src/lib/auth.ts).
// Hanya satu SUPER_ADMIN yang dibuat lewat seed. Pendaftaran publik dimatikan.
model User {
  id            String       @id @default(uuid(7)) @db.Uuid
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          Role         @default(USER)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  auditLogs     AuditLog[]
  loginEvents   LoginEvent[]
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  // hanya untuk sesi admin sendiri, tampil di halaman keamanan admin
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

// Password (hash scrypt dari Better Auth) disimpan di Account dengan providerId "credential".
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// Penghitung rate limit bersama untuk login (Better Auth customStorage) dan form publik.
// `key` selalu berupa hash HMAC, tidak pernah memuat IP mentah (Frontend/src/lib/rate-limit.ts).
// Jendela tetap: windowStart = awal jendela dalam epoch milidetik.
model RateLimit {
  key         String @id
  count       Int
  windowStart BigInt
}

// Singleton: selalu id = 1.
model Profile {
  id                Int      @id @default(1)
  name              String
  headline_id       String
  headline_en       String
  bio_id            String   @db.Text
  bio_en            String   @db.Text
  city              String?
  email             String?
  whatsapp          String?
  socials           Json     @default("{}")
  // nama yang tampil di kartu footer (judul dan teks kecil) bila diganti admin, per kunci kartu:
  // { "linkedin": { "title": "…", "value": "…" } }; kosong = nama bawaan dan teks dari tautan
  contactLabels     Json     @default("{}")
  currentRole_id    String?
  currentRole_en    String?
  // baris peran di pita halaman Tentang, mis. "Fullstack Developer | Community Manager"
  aboutRoles_id     String?
  aboutRoles_en     String?
  // peran di kartu ID bertali halaman Kontak, mis. "Fullstack Developer"
  photoId           String?  @unique @db.Uuid
  photo             Asset?   @relation("ProfilePhoto", fields: [photoId], references: [id], onDelete: SetNull)
  // foto kartu halaman Tentang (Admin → About → Profil, 2026-11-10); kosong = foto profil
  aboutPhotoId      String?  @unique @db.Uuid
  aboutPhoto        Asset?   @relation("ProfileAboutPhoto", fields: [aboutPhotoId], references: [id], onDelete: SetNull)
  // peran di pita halaman Tentang; kosong = peran beranda (aboutRoles)
  aboutBandRoles_id String?
  aboutBandRoles_en String?
  // chip (kampus/perusahaan) dan chip bendera di kartu foto halaman Tentang; showCampusChip nama lama
  // kolom chip umum (2026-11-15)
  showCampusChip    Boolean  @default(true)
  showFlag          Boolean  @default(true)
  // isi chip umum yang diubah admin: teks dan logo; kosong = pendidikan terbaru (nama dan logonya)
  aboutChipLabel_id String?
  aboutChipLabel_en String?
  aboutChipLogoId   String?  @unique @db.Uuid
  aboutChipLogo     Asset?   @relation("ProfileAboutChip", fields: [aboutChipLogoId], references: [id], onDelete: SetNull)
  cvId              String?  @unique @db.Uuid
  cv                Asset?   @relation("ProfileCv", fields: [cvId], references: [id], onDelete: SetNull)
  // link CV di luar (mis. Google Drive); bila diisi, /api/cv mengarah ke sini, bukan ke berkas upload
  cvUrl             String?
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
}

model Project {
  id             String          @id @default(uuid(7)) @db.Uuid
  slug           String          @unique
  title_id       String
  title_en       String
  summary_id     String
  summary_en     String
  // peran pemilik di project, tampil di atas judul pada daftar dan detail (opsional)
  role_id        String?
  role_en        String?
  description_id String          @db.Text
  description_en String          @db.Text
  caseStudy_id   String?         @db.Text
  caseStudy_en   String?         @db.Text
  year           Int
  category       ProjectCategory @default(SOFTWARE)
  demoUrl        String?
  repoUrl        String?
  // Super Admin memilih tombol yang tampil di detail: keduanya, salah satu, atau tidak ada.
  // Tombol hanya muncul bila tautannya juga diisi.
  showDemo       Boolean         @default(true)
  showRepo       Boolean         @default(true)
  // format "owner/repo" untuk metadata GitHub otomatis
  githubRepo     String?
  featured       Boolean         @default(false)
  order          Int             @default(0)
  status         ContentStatus   @default(DRAFT)
  publishedAt    DateTime?       @db.Timestamptz(3)
  coverId        String?         @db.Uuid
  cover          Asset?          @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  images         ProjectImage[]
  skills         Skill[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@index([status, order])
}

model ProjectImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId   String  @db.Uuid
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  @@unique([projectId, assetId])
}

model SkillCategory {
  id      String  @id @default(uuid(7)) @db.Uuid
  name_id String
  name_en String
  order   Int     @default(0)
  skills  Skill[]
}

model Skill {
  id         String        @id @default(uuid(7)) @db.Uuid
  name       String        @unique
  icon       String?
  // logo unggahan Admin → Home → Skill teknis (2026-11-12); kosong = logo bawaan (public/skills) atau ikon
  logoId     String?       @db.Uuid
  logo       Asset?        @relation("SkillLogo", fields: [logoId], references: [id], onDelete: SetNull)
  order      Int           @default(0)
  categoryId String        @db.Uuid
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  projects   Project[]
}

model Experience {
  id                 String          @id @default(uuid(7)) @db.Uuid
  type               ExperienceType
  // nama instansi; organization_en hanya diisi bila nama bahasa Inggrisnya berbeda
  // (mis. "Universitas Bina Nusantara" / "Bina Nusantara University")
  organization       String
  organization_en    String?
  title_id           String
  title_en           String
  description_id     String          @db.Text
  description_en     String          @db.Text
  startDate          DateTime        @db.Date
  // null = masih berlangsung
  endDate            DateTime?       @db.Date
  location           String?
  employmentType     EmploymentType?
  // jenis pekerjaan teks bebas per bahasa (mis. "Internship"); didahulukan dari employmentType (2026-11-16)
  employmentLabel_id String?         @db.VarChar(60)
  employmentLabel_en String?         @db.VarChar(60)
  order              Int             @default(0)
  status             ContentStatus   @default(PUBLISHED)
  logoId             String?         @db.Uuid
  logo               Asset?          @relation("ExperienceLogo", fields: [logoId], references: [id], onDelete: SetNull)
  // foto kegiatan di sisi seberang timeline (DESIGN.md bagian 38)
  photoId            String?         @db.Uuid
  photo              Asset?          @relation("ExperiencePhoto", fields: [photoId], references: [id], onDelete: SetNull)
  // titik di garis cerita "Dari komunitas ke software" di beranda (DESIGN.md bagian 46)
  inStory            Boolean         @default(false)
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  @@index([type, startDate])
}

model Asset {
  id               String         @id @default(uuid(7)) @db.Uuid
  // id di Cloudinary
  publicId         String         @unique
  url              String
  kind             AssetKind
  format           String?
  bytes            Int?
  width            Int?
  height           Int?
  alt_id           String?
  alt_en           String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  profilePhoto     Profile?       @relation("ProfilePhoto")
  profileCv        Profile?       @relation("ProfileCv")
  profileAboutOf   Profile?       @relation("ProfileAboutPhoto")
  profileChipOf    Profile?       @relation("ProfileAboutChip")
  projectCovers    Project[]      @relation("ProjectCover")
  projectImages    ProjectImage[]
  experiences      Experience[]   @relation("ExperienceLogo")
  experiencePhotos Experience[]   @relation("ExperiencePhoto")
  heroPortraitOf   SiteSetting?   @relation("HeroPortrait")
  contactCardOf    SiteSetting?   @relation("ContactCardPhoto")
  skillLogos       Skill[]        @relation("SkillLogo")
}

model Message {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String
  email     String
  subject   String?
  body      String        @db.Text
  status    MessageStatus @default(NEW)
  locale    String?
  // hash IP + garam, bukan IP mentah
  ipHash    String?
  readAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

// Statistik pengunjung tanpa cookie. visitorHash memakai garam harian.
// Data mentah disimpan 90 hari, lalu diringkas ke PageViewDaily oleh Vercel Cron.
model PageView {
  id           String   @id @default(uuid(7)) @db.Uuid
  path         String
  locale       String?
  referrerHost String?
  device       String?
  visitorHash  String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([path, createdAt])
}

// Ringkasan harian dari PageView, disimpan permanen (hemat kuota Neon 0,5 GB).
// locale "" berarti halaman tanpa bahasa (mis. /api atau 404 global).
model PageViewDaily {
  id       String   @id @default(uuid(7)) @db.Uuid
  date     DateTime @db.Date
  path     String
  locale   String   @default("")
  views    Int      @default(0)
  visitors Int      @default(0)

  @@unique([date, path, locale])
  @@index([date])
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
}

model CvDownload {
  id        String   @id @default(uuid(7)) @db.Uuid
  locale    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

// Pengaturan situs (satu baris, id = 1). Diubah dari /admin/settings.
model SiteSetting {
  id                 Int      @id @default(1)
  // tidak dipakai lagi sejak 2026-11-16 (volume utama dihapus); kolom dibiarkan agar tanpa migrasi yang menghapus data
  soundVolume        Int      @default(80)
  // volume tiap suara situs 0–100, mis. { "nav": 100, "theme": 60 }; suara yang
  // tidak ada di sini memakai volume penuh (features/settings/options.ts, SOUND_KINDS)
  soundMix           Json     @default("{}")
  // pemberitahuan pembuka: kartu sebelum masuk situs, sekali setiap situs dibuka (per sesi browser)
  introBody_id       String?  @db.Text
  introBody_en       String?  @db.Text
  // foto hero beranda yang diunggah admin; kosong = foto bawaan di repo (Frontend/src/assets/hero-*.webp)
  heroPortraitId     String?  @unique @db.Uuid
  heroPortrait       Asset?   @relation("HeroPortrait", fields: [heroPortraitId], references: [id], onDelete: SetNull)
  // foto di kartu ID halaman Kontak (Admin → Contact); kosong = potret hero
  contactPhotoId     String?  @unique @db.Uuid
  contactPhoto       Asset?   @relation("ContactCardPhoto", fields: [contactPhotoId], references: [id], onDelete: SetNull)
  // warna grafik kontribusi GitHub di beranda: { light: [4 hex], dark: [4 hex] }; kosong = biru bawaan
  githubPalette      Json?
  // Admin → Pengaturan (DESIGN.md bagian 119). Pilihan teks divalidasi Zod (features/settings/options.ts).
  // tema awal pengunjung yang belum memilih: dark | light | system
  defaultTheme       String   @default("dark")
  // efek cairan dan kursor titik+cincin di foto beranda
  heroAnimation      Boolean  @default(true)
  // bahasa saat alamat dibuka tanpa /id atau /en: browser | id | en
  defaultLocale      String   @default("browser")
  // kartu pembuka tampil (selama isinya lengkap) dan seberapa sering: once | visit | weekly
  introEnabled       Boolean  @default(true)
  introFrequency     String   @default("visit")
  // tombol WhatsApp melayang di pojok kanan bawah situs publik
  whatsappButton     Boolean  @default(false)
  // form kontak menerima pesan dan batas pesan per jam per IP
  contactOpen        Boolean  @default(true)
  contactPerHour     Int      @default(5)
  // tidak dipakai lagi sejak 2026-11-16 (saklar email pesan baru dihapus; email selalu terkirim bila Resend diatur); kolom dibiarkan agar tanpa migrasi yang menghapus data
  emailOnMessage     Boolean  @default(true)
  // email ke pemilik setiap ada login baru ke panel admin (butuh Resend)
  loginNotify        Boolean  @default(true)
  // statistik kunjungan dan lama kunjungan mentah disimpan (hari)
  trackVisits        Boolean  @default(true)
  visitRetentionDays Int      @default(90)
  // mesin pencari boleh mengindeks situs (robots.txt dan meta robots)
  // tidak dipakai lagi sejak 2026-11-16 (saklar dihapus; situs selalu boleh diindeks kecuali mode perawatan); kolom dibiarkan tanpa migrasi yang menghapus data
  allowIndexing      Boolean  @default(true)
  // pengunjung melihat halaman "Sedang diperbarui"; panel admin tetap bisa dipakai
  maintenanceMode    Boolean  @default(false)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
}

// Riwayat masuk panel admin (Admin → Akun, DESIGN.md bagian 120): berhasil dan gagal. Tanpa IP dan
// tanpa email yang diketik; hanya user-agent (diringkas saat ditampilkan) dan kota/negara dari header
// Vercel. Dihapus setelah 90 hari oleh cron harian.
model LoginEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  // null: percobaan dengan email yang tidak terdaftar
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // success | failed
  kind      String
  // sesi yang dibuat oleh login berhasil (tanpa relasi: sesi dihapus saat keluar)
  sessionId String?  @db.Uuid
  userAgent String?  @db.VarChar(300)
  location  String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([sessionId])
}

// Teks situs yang diubah admin (judul bagian, SEO, kebijakan privasi, ...). Menimpa teks bawaan di
// messages/*.json. Kunci "Namespace.nama" dibatasi daftar di features/site-text/catalog.ts. Kolom
// kosong berarti memakai teks bawaan bahasa itu.
model SiteText {
  key       String   @id
  value_id  String?  @db.Text
  value_en  String?  @db.Text
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
