// Skema database portofolio. Acuan: Documentation/ARCHITECTURE.md bagian 5.
// Prisma CLI dijalankan dari folder Frontend/ (lihat Frontend/prisma.config.ts).
// Konten publik dua bahasa memakai pasangan kolom `*_id` (Indonesia) dan `*_en` (Inggris).
// Primary key memakai UUID v7 (urut waktu). Semua waktu disimpan sebagai timestamptz (UTC),
// ditampilkan dalam zona Asia/Jakarta. Tanggal kalender (startDate/endDate) memakai @db.Date.

generator client {
  provider = "prisma-client"
  output   = "../Frontend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  SUPER_ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum ProjectCategory {
  SOFTWARE
  COMMUNITY_BUSINESS
}

enum ExperienceType {
  WORK
  EDUCATION
  ORGANIZATION
}

// Jenis pekerjaan seperti di LinkedIn, tampil di baris instansi ("PT PGAS Solution · Internship")
enum EmploymentType {
  FULL_TIME
  PART_TIME
  SELF_EMPLOYED
  FREELANCE
  CONTRACT
  INTERNSHIP
  APPRENTICESHIP
  SEASONAL
  VOLUNTEER
}

enum AssetKind {
  IMAGE
  DOCUMENT
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum SubscriberStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

enum Availability {
  OPEN
  BUSY
  NOT_LOOKING
}

// Tabel autentikasi mengikuti skema Better Auth (lihat Frontend/src/lib/auth.ts).
// Hanya satu SUPER_ADMIN yang dibuat lewat seed. Pendaftaran publik dimatikan.
model User {
  id            String     @id @default(uuid(7)) @db.Uuid
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          Role       @default(USER)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  auditLogs     AuditLog[]
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  // hanya untuk sesi admin sendiri, tampil di halaman keamanan admin
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

// Password (hash scrypt dari Better Auth) disimpan di Account dengan providerId "credential".
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// Penghitung rate limit bersama untuk login (Better Auth customStorage) dan form publik.
// `key` selalu berupa hash HMAC, tidak pernah memuat IP mentah (Frontend/src/lib/rate-limit.ts).
// Jendela tetap: windowStart = awal jendela dalam epoch milidetik.
model RateLimit {
  key         String @id
  count       Int
  windowStart BigInt
}

// Singleton: selalu id = 1.
model Profile {
  id                  Int          @id @default(1)
  name                String
  headline_id         String
  headline_en         String
  bio_id              String       @db.Text
  bio_en              String       @db.Text
  city                String?
  email               String?
  whatsapp            String?
  socials             Json         @default("{}")
  availability        Availability @default(OPEN)
  availabilityNote_id String?
  availabilityNote_en String?
  currentRole_id      String?
  currentRole_en      String?
  // baris peran di pita halaman Tentang, mis. "Fullstack Developer | Community Manager"
  aboutRoles_id       String?
  aboutRoles_en       String?
  // peran di kartu ID bertali halaman Kontak, mis. "Fullstack Developer"
  cardRole_id         String?
  cardRole_en         String?
  photoId             String?      @unique @db.Uuid
  photo               Asset?       @relation("ProfilePhoto", fields: [photoId], references: [id], onDelete: SetNull)
  cvId                String?      @unique @db.Uuid
  cv                  Asset?       @relation("ProfileCv", fields: [cvId], references: [id], onDelete: SetNull)
  // link CV di luar (mis. Google Drive); bila diisi, /api/cv mengarah ke sini, bukan ke berkas upload
  cvUrl               String?
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
}

model Project {
  id             String          @id @default(uuid(7)) @db.Uuid
  slug           String          @unique
  title_id       String
  title_en       String
  summary_id     String
  summary_en     String
  description_id String          @db.Text
  description_en String          @db.Text
  caseStudy_id   String?         @db.Text
  caseStudy_en   String?         @db.Text
  year           Int
  category       ProjectCategory @default(SOFTWARE)
  demoUrl        String?
  repoUrl        String?
  // format "owner/repo" untuk metadata GitHub otomatis
  githubRepo     String?
  featured       Boolean         @default(false)
  order          Int             @default(0)
  status         ContentStatus   @default(DRAFT)
  publishedAt    DateTime?       @db.Timestamptz(3)
  coverId        String?         @db.Uuid
  cover          Asset?          @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  images         ProjectImage[]
  skills         Skill[]
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  @@index([status, order])
}

model ProjectImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assetId   String  @db.Uuid
  asset     Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  order     Int     @default(0)

  @@unique([projectId, assetId])
}

model SkillCategory {
  id      String  @id @default(uuid(7)) @db.Uuid
  name_id String
  name_en String
  order   Int     @default(0)
  skills  Skill[]
}

model Skill {
  id         String        @id @default(uuid(7)) @db.Uuid
  name       String        @unique
  icon       String?
  order      Int           @default(0)
  categoryId String        @db.Uuid
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  projects   Project[]
}

model Experience {
  id              String          @id @default(uuid(7)) @db.Uuid
  type            ExperienceType
  // nama instansi; organization_en hanya diisi bila nama bahasa Inggrisnya berbeda
  // (mis. "Universitas Bina Nusantara" / "Bina Nusantara University")
  organization    String
  organization_en String?
  title_id        String
  title_en        String
  description_id  String          @db.Text
  description_en  String          @db.Text
  startDate       DateTime        @db.Date
  // null = masih berlangsung
  endDate         DateTime?       @db.Date
  location        String?
  employmentType  EmploymentType?
  order           Int             @default(0)
  status          ContentStatus   @default(PUBLISHED)
  logoId          String?         @db.Uuid
  logo            Asset?          @relation("ExperienceLogo", fields: [logoId], references: [id], onDelete: SetNull)
  // foto kegiatan di sisi seberang timeline (DESIGN.md bagian 38)
  photoId         String?         @db.Uuid
  photo           Asset?          @relation("ExperiencePhoto", fields: [photoId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@index([type, startDate])
}

model Asset {
  id               String         @id @default(uuid(7)) @db.Uuid
  // id di Cloudinary
  publicId         String         @unique
  url              String
  kind             AssetKind
  format           String?
  bytes            Int?
  width            Int?
  height           Int?
  alt_id           String?
  alt_en           String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  profilePhoto     Profile?       @relation("ProfilePhoto")
  profileCv        Profile?       @relation("ProfileCv")
  projectCovers    Project[]      @relation("ProjectCover")
  projectImages    ProjectImage[]
  experiences      Experience[]   @relation("ExperienceLogo")
  experiencePhotos Experience[]   @relation("ExperiencePhoto")
}

model Message {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String
  email     String
  subject   String?
  body      String        @db.Text
  status    MessageStatus @default(NEW)
  locale    String?
  // hash IP + garam, bukan IP mentah
  ipHash    String?
  readAt    DateTime?     @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([status, createdAt])
}

model Subscriber {
  id             String           @id @default(uuid(7)) @db.Uuid
  email          String           @unique
  status         SubscriberStatus @default(PENDING)
  // hash token konfirmasi/berhenti, token asli hanya dikirim lewat email
  tokenHash      String           @unique
  locale         String           @default("id")
  confirmedAt    DateTime?        @db.Timestamptz(3)
  unsubscribedAt DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
}

model Broadcast {
  id             String    @id @default(uuid(7)) @db.Uuid
  subject        String
  body           String    @db.Text
  recipientCount Int       @default(0)
  sentAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
}

// Statistik pengunjung tanpa cookie. visitorHash memakai garam harian.
// Data mentah disimpan 90 hari, lalu diringkas ke PageViewDaily oleh Vercel Cron.
model PageView {
  id           String   @id @default(uuid(7)) @db.Uuid
  path         String
  locale       String?
  referrerHost String?
  device       String?
  visitorHash  String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
  @@index([path, createdAt])
}

// Ringkasan harian dari PageView, disimpan permanen (hemat kuota Neon 0,5 GB).
// locale "" berarti halaman tanpa bahasa (mis. /api atau 404 global).
model PageViewDaily {
  id       String   @id @default(uuid(7)) @db.Uuid
  date     DateTime @db.Date
  path     String
  locale   String   @default("")
  views    Int      @default(0)
  visitors Int      @default(0)

  @@unique([date, path, locale])
  @@index([date])
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
}

model CvDownload {
  id        String   @id @default(uuid(7)) @db.Uuid
  locale    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt])
}

// Pengaturan situs (satu baris, id = 1). Diubah dari /admin/settings.
model SiteSetting {
  id          Int      @id @default(1)
  // volume suara tombol di situs publik (tema, bahasa, menu), 0 = tanpa suara, 100 = paling keras
  soundVolume Int      @default(80)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}
